{
    "manifest_version": 3,
    "name": "US Visa Appointment Scheduler",
    "version": "2.1.0",
    "description": "Advanced US visa appointment rescheduler with auto-login and monitoring capabilities. Supports multiple languages.",
    "permissions": [
        "scripting",
        "activeTab",
        "storage",
        "notifications"
    ],
    "host_permissions": [
        "https://ais.usvisa-info.com/*"
    ],
    "action": {
        "default_popup": "src/html/popup.html",
        "default_title": "US Visa Scheduler",
        "default_icon": {
            "16": "assets/icons/icon16.png",
            "48": "assets/icons/icon48.png",
            "128": "assets/icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "src/js/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://ais.usvisa-info.com/*"
            ],
            "js": [
                "src/js/i18n.js",
                "src/js/content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "locales/*.json",
                "src/js/i18n.js"
            ],
            "matches": [
                "https://ais.usvisa-info.com/*"
            ]
        }
    ],
    "icons": {
        "16": "assets/icons/icon16.png",
        "48": "assets/icons/icon48.png",
        "128": "assets/icons/icon128.png"
    }
}